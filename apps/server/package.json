{
  "name": "@slop/server",
  "version": "0.0.0",
  "private": true,
  "description": "Fastify + Socket.IO game server: queue, timers, lifecycle, chain bridge, moderation. The only thing that talks to Supabase.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "purge-queue": "tsx ../../scripts/purge-queue.ts",
    "lint": "echo \"[server] no lint configured yet\""
  },
  "dependencies": {
    "@slop/shared": "workspace:*",
    "@slop/program-client": "workspace:*",
    "@supabase/supabase-js": "^2.45.4",
    "@solana/web3.js": "^1.98.0",
    "@fastify/cors": "^10.0.1",
    "fastify": "^5.1.0",
    "socket.io": "^4.8.1",
    "bs58": "^6.0.0",
    "dotenv": "^16.4.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
