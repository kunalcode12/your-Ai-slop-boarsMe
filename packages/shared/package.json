{
  "name": "@slop/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Single source of truth for cross-cutting contracts: constants, types, zod schemas, socket event names.",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/esm/index.d.ts", "default": "./dist/esm/index.js" },
      "require": { "types": "./dist/cjs/index.d.ts", "default": "./dist/cjs/index.js" }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/fixup.mjs",
    "dev": "tsc -p tsconfig.esm.json --watch",
    "typecheck": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "lint": "echo \"[shared] no lint configured yet\""
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3"
  }
}
