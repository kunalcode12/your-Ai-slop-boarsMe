  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "@types/node": "^22.10.5",
    "dotenv": "^16.4.7",
    "pg": "^8.13.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
