{
  "name": "slop",
  "version": "0.0.0",
  "private": true,
  "description": "your ai slop bores me — a parody AI chat where the model is a random human. Monorepo root.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
