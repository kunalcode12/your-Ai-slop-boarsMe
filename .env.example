# =============================================================================
# your ai slop bores me — environment variables
# Copy to `.env` and fill in. NEVER commit the real `.env`.
# Network is Solana DEVNET everywhere. The credit "token" has no real value.
# =============================================================================

# -----------------------------------------------------------------------------
# Solana / MagicBlock (used by apps/server and programs/credits tooling)
# -----------------------------------------------------------------------------
# Devnet JSON-RPC endpoint (base layer — settlement / source of truth).
SOLANA_RPC_URL=https://api.devnet.solana.com

# MagicBlock ephemeral-rollup endpoint (gasless, low-latency credit ops).
# OPTIONAL: leave blank to run credits on plain devnet only (the app never blocks on ER).
# Devnet ER node (verified): https://devnet.magicblock.app
# Magic Router (auto-routes base+ER per account): https://devnet-router.magicblock.app
# Regional ER nodes: https://devnet-as.magicblock.app | -us | -eu  (docs.magicblock.gg)
MAGICBLOCK_RPC_URL=https://devnet.magicblock.app

# Deployed Anchor program id for the credits program (base58).
PROGRAM_ID=2Eiw45DD1dd39ZQ5eRcMnY9zj4Qd5uYnKVxnjfEe9B1U

# Server-controlled keypair: funds burner wallets (airdrop) and acts as fee
# payer so users never see a wallet popup. Provide ONE of the two:
#   - path to a Solana CLI keypair json file, OR
#   - the base58-encoded secret key directly (preferred for hosted envs).
SERVER_KEYPAIR_PATH=./server-keypair.json
SERVER_KEYPAIR_SECRET=

# -----------------------------------------------------------------------------
# Supabase (apps/server ONLY — clients never touch the DB directly)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://wusfzvwcrafjqqdyugdn.supabase.co
# Service-role key. Server-side secret. DO NOT expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Ind1c2Z6dndjcmFmanFxZHl1Z2RuIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4MjEzMjc5NywiZXhwIjoyMDk3NzA4Nzk3fQ.Xnj3O6WjQznJbQIMMX4ZXHl0XHQ6tgF-gL5lSXFhcOc
# Storage bucket that holds answer drawing PNGs.
SUPABASE_STORAGE_BUCKET=slop-drawings

# -----------------------------------------------------------------------------
# Database (direct Postgres) — used ONLY to apply SQL migrations (DDL).
# The service-role key above CANNOT run DDL; migrations need the DB password.
# Replace [YOUR-PASSWORD] with the project's database password.
#   DIRECT_URL  = session-mode pooler (port 5432) — used for migrations.
#   DATABASE_URL= transaction-mode pooler (port 6543) — for runtime pooled queries.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.wusfzvwcrafjqqdyugdn:[YOUR-PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.wusfzvwcrafjqqdyugdn:[YOUR-PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres

# -----------------------------------------------------------------------------
# Game server (apps/server)
# -----------------------------------------------------------------------------
PORT=8080
# Allowed browser origin for CORS + Socket.IO (the web app's URL).
CLIENT_ORIGIN=http://localhost:3000
# Bearer token guarding the /admin moderation endpoints. Leave blank to DISABLE
# /admin (returns 503). Set to a long random string in any shared/hosted env.
ADMIN_TOKEN=

# -----------------------------------------------------------------------------
# Web frontend (apps/web) — only NEXT_PUBLIC_* vars reach the browser
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SERVER_URL=http://localhost:8080
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_PROGRAM_ID=2Eiw45DD1dd39ZQ5eRcMnY9zj4Qd5uYnKVxnjfEe9B1U
